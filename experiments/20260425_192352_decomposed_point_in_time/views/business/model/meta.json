{
  "model_name": "autoencoder",
  "framework": "pytorch",
  "input_dim": 64,
  "embedding_dim": 32,
  "hidden_dims": [
    256,
    128
  ],
  "dropout": 0.0,
  "learning_rate": 0.001,
  "epochs": 40,
  "batch_size": 512,
  "weight_decay": 1e-05,
  "random_seed": 7,
  "train_val_split": 0.85,
  "early_stopping_patience": 10,
  "standardized": true,
  "normalization_buffers": [
    "feature_mean",
    "feature_scale"
  ]
}